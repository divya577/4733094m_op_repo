# Ensure Apache2 is installed
package { 'apache2':
  ensure => installed,
}

# Start Apache2 service
service { 'apache2':
  ensure    => running,
  enable    => true,
  require   => Package['apache2'],
}

file { '/tmp/4733094m/research':
  ensure  => 'absent',
  require => Service['apache2'],
}

file { '/tmp/4733094m/research':
  ensure  => 'directory',
}

# Clone the repository
exec { 'Clone repository':
  command => 'git clone https://github.com/divya577/4733094m_op_repo.git /tmp/4733094m/research',
  path    => ['/usr/bin', '/bin'],
}

# Replace index.html with updated version
file { '/var/www/html/index.html':
  ensure  => file,
  source  => 'puppet:///modules/webserver/4733094m_index.html',
  require => Service['apache2'],
}

