pipeline {
    agent any

    stages {
        stage('4733094m-opr-s1') {
            steps {
                script {
                    sh 'docker rmi -f uatsvr_image || true'
                    sh 'docker commit 4733094m_uatsvr uatsvr_image'
                    
                    sh '''#!/bin/bash
                    
                    # Ensure /tmp/4733094m/research is absent, then create as directory
                    puppet resource file /tmp/4733094m ensure=directory ;
                    puppet resource file /tmp/4733094m/research ensure=absent force=true;
                    puppet resource file /tmp/4733094m/research ensure=directory ;
                    
                    cd /tmp/4733094m/research;
                    git clone -b Prod https://github.com/divya577/4733094m_op_repo.git;
                    ls -l /tmp/4733094m/research/4733094m_op_repo

                    targets=4733094m_uatsvr.localdomain;
                    locate_script='/tmp/4733094m/research/4733094m_op_repo/4733094m_script';

                    bolt script run $locate_script -t $targets -u clientadm -p user123 --no-host-key-check --run-as root;
                    '''
                    echo '4733094m_OP_S1: uat web server is backup and updated'
                }
            }
        }
     stage('4733094m-opr-s2') {
            steps {
                script {
                    sh '''#!/bin/bash
                    
                    # Perform web test for UAT server
                    curl -Is http://4733094m_uatsvr.localdomain | head -n 1 > /tmp/uatsvr-result-file
                    
                    # Check the result of the web test
                    if grep -q "HTTP/1.1 200 OK" /tmp/uatsvr-result-file; then
                        echo '4733094m_OP_S2: uat svr is running'
                    else
                        echo '4733094m_OP_S2: uat svr fails'
                    fi
                    '''
                }
            }
        }
    stage('4733094m-opr-s3') {
            steps {
                script {
                    echo "4733094m_OP_S3: Proceed stress test uat web server?"
                    input message: 'Proceed with stress test on uat web server or Abort (for uat svr fails)?', ok: 'Proceed', cancel: 'Abort'
                }
            }
        }

        stage('4733094m-opr-s4') {
            steps {
                script {
                    echo "4733094m_OP_S4: Stress test result is good"
                }
            }
        }
    stage('4733094m-opr-s5') {
            steps {
                script {
                    echo "4733094m_OP_S5: Deploy new update to prod web server?"
                    input message: 'Proceed to update prod web server or Abort (for stress test fails)?', ok: 'Proceed', cancel: 'Abort'
                }
            }
        }
     stage('4733094m-opr-s6') {
            steps {
                script {
                    sh 'docker rmi -f prodsvr_image || true'
                    sh 'docker commit 4733094m_prodsvr prodsvr_image'

                    sh '''#!/bin/bash                

                     # Ensure /tmp/4733094m/research is absent, then create as directory
                    puppet resource file /tmp/4733094m ensure=directory ;
                    puppet resource file /tmp/4733094m/research ensure=absent force=true;
                    puppet resource file /tmp/4733094m/research ensure=directory ;

                    cd /tmp/4733094m/research;
                    git clone -b Prod https://github.com/divya577/4733094m_op_repo.git;

                    # Update prod server by executing bolt command
                    targets=4733094m_prodsvr.localdomain;
                    locate_script='/tmp/4733094m/research/4733094m_op_repo/4733094m_script';
                    
                    bolt script run $locate_script -t $targets -u clientadm -p user123 --no-host-key-check --run-as root;
                    '''
                    echo '4733094m_OP_S6: prod web server is backup and updated'
                    
                }
            }
        }
    stage('4733094m-opr-s7') {
    steps {
        script {
            sh '''#!/bin/bash
            
            # Perform web test for production server
            curl -Is http://4733094m_prodsvr.localdomain | head -n 1 > /tmp/prodsvr-result-file
            
            # Check the result of the web test
            if grep -q "HTTP/1.1 200 OK" /tmp/prodsvr-result-file; then
                echo "4733094m_OP_S7: Production website is operational"
                exit 0
            else
                echo "4733094m_OP_S7: Production website check failed"
                exit 1
            fi
            '''
        }
    }
    post {
        failure {
            script {
                def userChoice = input(
                    message: 'Production website check failed. Choose an action:',
                    parameters: [
                        choice(name: 'Action', choices: ['Trigger roll back', 'Troubleshooting'], description: 'Select an option')
                    ]
                )

                if (userChoice == 'Trigger roll back') {
                    echo '4733094m_OP_S7: Production website is rolling back'
                } else {
                    echo '4733094m_OP_S7: Troubleshooting of Production website is in progress'
                }
            }
        }
    }
}
    }
}
